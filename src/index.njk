---
layout: toc.njk
title: '~*° joy jade'
section: Featured

---
{% import 'video.njk' as vid %}

{% set relpath = "/content/img/" %}

<!-- Main Page-->
<section class="contents projects">
  <div class="featured-container container">
    Featured Projects
    {% for proj in projects %}
      {% if proj.featured %}
        <div>
          <h1>{{ proj.title }}</h1>
          <h1>{{ proj.year }}</h1>
          <h1>{{ proj.link }}</h1>
          <div class="horizontal window">
            {% for img in proj.image_files %}
              {% if not img.type %}
                <div class="image">      

                    {% set ext = (img.ext if img.ext else ".jpg") %}    
                    <img src="{{relpath+img.src+ext}}" alt="img.alt" class="lazy">
          
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>


