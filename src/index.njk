---
layout: toc.njk
title: '~*° joy jade'
section: Featured

---
{% import 'video.njk' as vid %}

{% set relpath = "/content/img/" %}

<!-- Main Page-->
<section class="contents projects">
  <div class="featured-container container">
    <h1>Featured Projects</h1>
    {% for proj in projects %}
      {% if proj.featured %}
        <div class="featured">
          <div>
          </div>
          <div class="horizontal window">
            {% for img in proj.image_files %}
              {% if img.feat %}
                <div class="image">      
                    {% set ext = (img.ext if img.ext else ".jpg") %}    
                    <img src="{{relpath+img.src+ext}}" alt="img.alt" eleventy:widths="400,2000" class="lazy" sizes="(min-width: 1280px) 300px, 50vw">
                </div>
              {% endif %}
            {% endfor %}
          </div> 
          <div class="subheading">
            <div class="">
              {# <span>{{ proj.year }}</span> #}
              <h2>
                  <a href="/projects/{{ proj.title | slugify }}">{{ proj.title }}</a>              
              </h2>
              {% if proj.link %}
                <a class="button" href="{{ proj.link }}">↗</a>
              {% endif %}
            </div>
            <div>
              <h2>
              {% if proj.role %}
                {{ proj.role }}
              {% endif %}
              </h2>
            </div>

          </div> 
        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>


